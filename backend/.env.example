# Copy to backend/.env for local development. Only read when APP_ENV=local.
# Staging/production inject these from the cloud secret manager — never commit real values.
APP_ENV=local
BIND_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://fuber:fuber-local-only@127.0.0.1:5432/fuber
REDIS_URL=redis://127.0.0.1:6379
# PEM CA certificate for a rediss:// server whose CA is not publicly trusted (Memorystore
# on staging/production, injected from Secret Manager). Not needed locally.
# REDIS_CA_CERT=
# Exact origins only. Capacitor apps use capacitor://localhost (iOS) and https://localhost (Android).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost
# Number of trusted proxies appending to X-Forwarded-For (0 = none, use the peer address).
TRUSTED_PROXY_HOPS=0
# Optional JSON overriding rate limits, e.g. {"fare_estimate":{"limit":60,"window_s":60}}
# RATE_LIMITS=
RUST_LOG=info,tower_http=debug

# --- Identity & onboarding (Phase 1) ---------------------------------------------------------
# Secrets: at least 32 random characters each (e.g. `openssl rand -base64 48`). These values
# are for local development only: the API refuses any value containing "local-only" outside
# APP_ENV=local. Changing DATA_KEY makes existing encrypted fields unreadable.
HASH_SECRET=local-only-hash-secret-change-me-0000000000
DATA_KEY=local-only-data-key-change-me-00000000000000
JWT_SECRET=local-only-jwt-secret-change-me-000000000000
JWT_KID=k1
# During signing-key rotation, the previous key id and secret (both or neither):
# JWT_PREVIOUS_KID=
# JWT_PREVIOUS_SECRET=
# SMS: only the fake gateway exists until the SMS vendors are chosen. Locally it prints each
# SMS, including sign-in codes, to the API log.
SMS_PROVIDER=fake
# Files (ID photos, driver documents): local disk until the cloud provider is chosen.
STORAGE_BACKEND=local
STORAGE_DIR=var/storage
# Base URL phones use to reach this API; signed upload links point here. For a real phone on
# Wi-Fi use your PC's address, e.g. http://192.168.1.20:8080, with BIND_ADDR=0.0.0.0:8080.
PUBLIC_API_URL=http://127.0.0.1:8080
# Virus scanning of uploads. `disabled` is allowed only with APP_ENV=local. To scan locally,
# run `docker compose -f infra/docker-compose.yml --profile scan up -d`, then set:
# VIRUS_SCAN=clamav
# CLAMAV_ADDR=127.0.0.1:3310
VIRUS_SCAN=disabled
# Road routing for quotes and ETAs. `estimate` (straight line × 1.3) is for local development
# only; to use real roads run infra/osrm/build.sh, start the `routing` profile, then set:
# ROUTING=osrm
# OSRM_URL=http://127.0.0.1:5000
ROUTING=estimate
